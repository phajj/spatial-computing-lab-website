// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Media {
  id          String   @id @default(cuid())
  title       String
  src         String
  thumb       String?
  type        String
  category    String?
  collection  String?
  description String?
  location    String?
  date        DateTime?
  featured    Boolean  @default(false)
  hotspots    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("media")
}

// Better Auth's own tables (session-based email + password auth).
// The admin-facing identity fields (email, password) live here as
// Better Auth expects, rather than as a hand-rolled password_hash column.
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  name          String?
  // Locked accounts (via the lock-admin script) can't sign in — enforced
  // in the session-create hook in src/lib/auth.ts — without deleting the
  // account or its history.
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@map("admins")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adminId String @map("admin_id")
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Stores the hashed password for email+password sign-in (Better Auth's
// "credential" provider account), keyed to the admin it belongs to.
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  adminId String @map("admin_id")
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}
