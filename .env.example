DATABASE_URL="file:../data/lab.db"
MEDIA_DIR=
BETTER_AUTH_SECRET=
# Where admins sign in. Dev: http://localhost:49168. Server: the public HTTPS URL
# admins sign in at, e.g. https://<public site URL>.
BETTER_AUTH_URL="http://localhost:49168"
# Set to true once the site is served over HTTPS. While it's plain HTTP, a
# Secure cookie is never sent back and admin sign-in silently fails.
COOKIE_SECURE=false
